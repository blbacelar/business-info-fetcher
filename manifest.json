{
  "manifest_version": 3,
  "name": "Business Info Fetcher",
  "version": "1.0",
  "description": "Fetches business information",
  "action": {
    "default_popup": ""
  },
  "permissions": ["activeTab", "scripting", "webNavigation", "storage", "tabs"],
  "host_permissions": ["https://maps.googleapis.com/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  }
}
