{
  "manifest_version": 3,
  "name": "Business Info Fetcher",
  "version": "1.0",
  "description": "Fetches business information",
  "action": {
    "default_title": "Business Info Fetcher"
  },
  "permissions": ["activeTab", "scripting", "webNavigation", "storage", "tabs"],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "https://www.google.com/maps/*",
    "https://www.googleadservices.com/*",
    "chrome-extension://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
